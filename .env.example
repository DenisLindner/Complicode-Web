# Public origin of this app (used to check the Origin of requests).
APP_URL=http://localhost:3001

# Complicode API. Only the Next.js server talks to it, so it is never sent to
# the browser. In production it should live on a private network.
API_URL=http://localhost:3000/api
# Shared secret sent in X-Internal-Key; must match INTERNAL_API_KEY in the API.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# Key that encrypts the session cookies (at least 32 characters).
# Generate with the same command above. Changing it logs everyone out.
SESSION_SECRET=

# Reverse proxies in front of this app that append to X-Forwarded-For
# (load balancer, CDN). The client IP sent to the API rate limit is the entry
# added by the outermost one. Keep at least 1 and never expose Next.js
# directly in production, or the client could forge its IP.
TRUSTED_PROXY_HOPS=1
